# Server and admin notification configuration

# Express server port
PORT=3000

# SQLite database file is created automatically in the project root.

# Admin email addresses receive RSVP notifications. Separate multiple emails with commas.
ADMIN_EMAILS=admin1@example.com,admin2@example.com

# SMTP settings for email notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
EMAIL_FROM=no-reply@yourdomain.com

# Send a confirmation email to the guest who submits the form
SEND_USER_CONFIRMATION=true
